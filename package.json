{
  "name": "erim-psh-desktop",
  "version": "1.1.13",
  "private": true,
  "description": "ERM-PSH desktop operations workspace",
  "main": "desktop/main.cjs",
  "author": "Peak Season Holidays",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/lib/backend-health-service.cjs && node --check desktop/lib/database.cjs && node --check desktop/lib/google-auth-service.cjs && node --check desktop/lib/google-workspace-service.cjs && node --check desktop/lib/itinerary-extractor.cjs && node --check desktop/lib/supplier-excel-service.cjs && node --check desktop/lib/supplier-workbook-schema.cjs && node --check desktop/lib/sync-service.cjs && node --check desktop/lib/update-service.cjs && node --check desktop/renderer/app.js",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win nsis",
    "release:draft": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.peakseasonholidays.erimpsh",
    "productName": "ERIM-PSH",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ERIM-PSH-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERIM-PSH",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hadesolympuz-ID",
        "repo": "ERIM-PSH",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "mammoth": "1.10.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
